{
  "expo": {
    "name": "HeroFit",
    "slug" : "herofit",
    "owner":"brysonmk1984",
    "version": "1.4.7",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "herofit",
    "splash": {
      "image": "./assets/splash-background-night.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "privacy": "public",
    "plugins": ["sentry-expo"],
    "hooks": {
      "postPublish": [
        {
          "file": "sentry-expo/upload-sourcemaps",
          "config": {
            "organization": "herofit",
            "project": "herofit",
            "authToken": "da2016af30174727829c0cfa9e19bbc3815e7ec19d684e33b1f9826021348ecd"
          }
        }
      ]
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    
    "android": {

      "adaptiveIcon": {
        "foregroundImage": "./assets/logo512.png",
        "backgroundColor": "#d4af37"
      },
      "package": "com.herofitllc.herofit",
      "permissions": [],
      "versionCode": 23
    },
    "ios": {
    "bundleIdentifier": "com.herofitllc.herofit",
     "buildNumber": "1.0.0",
      "infoPlist": {
         "LSApplicationQueriesSchemes": [
            "message",
            "readdle-spark",
            "airmail",
            "ms-outlook",
            "googlegmail",
            "inbox-gmail",
            "ymail",
            "superhuman",
            "yandexmail"
         ]
      }
   },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
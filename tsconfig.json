{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2015",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "incremental": true
  },
  "rules" : {
    "no-console": {
      "severity": "warning",
      "options": ["debug", "info", "log", "time", "timeEnd", "trace"]
  },
  "include" : ["src/**/*"],
  "exclude": ["node_modules/**/*"]
}